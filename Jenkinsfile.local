// Pipeline local: corre en el propio controlador Jenkins (agent any), pensado para
// demostrar el flujo CI/CD contra el cluster local (Docker Desktop / kind).
// El Jenkinsfile principal usa agentes Kubernetes y está pensado para un cluster real.
pipeline {
    agent any

    environment {
        DOCKER_ORG = 'jrivera340'
        KUBECONFIG = '/var/jenkins_home/.kube/config'
        NS         = 'circleguard-dev'
        TAG        = "v1.0.${env.BUILD_NUMBER}"
        SERVICES   = 'auth identity form promotion gateway notification dashboard file'
        SONAR_URL  = 'http://host.docker.internal:30900'
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Unit Tests') {
            steps {
                sh './gradlew test --no-daemon'
            }
            post {
                always { junit testResults: 'services/**/build/test-results/test/*.xml', allowEmptyResults: true }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                // Best-effort: si el server o el token no están, no rompe el build.
                sh '''
                    ./gradlew sonar --no-daemon \
                        -Dsonar.host.url=${SONAR_URL} \
                        -Dsonar.projectKey=circleguard \
                        -Dsonar.sources=services \
                        -Dsonar.exclusions=**/build/**,**/*.class \
                        || echo "SonarQube best-effort: revisar server/token en ${SONAR_URL}"
                '''
            }
        }

        stage('Build & Push Images') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh './gradlew jib --no-daemon'
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                    curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh \
                        | sh -s -- -b /tmp/bin v0.51.0 || true
                    for s in $SERVICES; do
                        echo "=== Trivy: $DOCKER_ORG/circleguard-$s-service:$TAG ==="
                        /tmp/bin/trivy image --scanners vuln --severity HIGH,CRITICAL \
                            --format table --output trivy-$s.txt \
                            $DOCKER_ORG/circleguard-$s-service:$TAG || true
                    done
                '''
                archiveArtifacts artifacts: 'trivy-*.txt', allowEmptyArchive: true
            }
        }

        stage('Semantic Version Tag') {
            steps {
                sh '''
                    LAST=$(git describe --tags --abbrev=0 2>/dev/null || echo v0.0.0)
                    MAJOR=$(echo $LAST | cut -d. -f1 | tr -d v)
                    MINOR=$(echo $LAST | cut -d. -f2)
                    PATCH=$(echo $LAST | cut -d. -f3)
                    NEW="v${MAJOR}.${MINOR}.$((PATCH + 1))"
                    git tag -a "$NEW" -m "Release $NEW (build ${BUILD_NUMBER})" || true
                    echo "Versión semántica generada: $NEW"
                '''
            }
        }

        stage('Deploy DEV') {
            steps {
                sh '''
                    for s in $SERVICES; do
                        kubectl set image deployment/circleguard-$s-service \
                            circleguard-$s-service=$DOCKER_ORG/circleguard-$s-service:$TAG -n $NS || true
                    done
                    for s in auth identity form promotion gateway notification; do
                        kubectl rollout status deployment/circleguard-$s-service -n $NS --timeout=180s || true
                    done
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                sh '''
                    kubectl exec -n $NS deploy/circleguard-gateway-service -- \
                        wget -qO- --post-data='{"token":"smoke"}' \
                        --header='Content-Type: application/json' \
                        http://localhost:8087/api/v1/gate/validate
                '''
            }
        }
    }

    post {
        success { echo "Pipeline OK — imágenes $TAG desplegadas en $NS" }
        failure { echo "Pipeline FALLÓ — revisar logs del stage" }
    }
}
